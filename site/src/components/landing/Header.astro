---
import { getContent, languages, type Lang } from "@/i18n/content";
import { getAlternates } from "@/i18n/utils";
import BrandMark from "@/components/landing/BrandMark.astro";

const repo = "https://github.com/OtterlySpaceLabs/speekify";
const lang = (Astro.currentLocale ?? "en") as Lang;
const t = getContent(lang);
const alternates = getAlternates(Astro.url.pathname, lang);
const navLinks = [
	{ href: "#sources", label: lang === "fr" ? "Sources" : "Sources" },
	{ href: "#how", label: t.nav.how },
	{ href: "#cli", label: t.nav.cli },
	{ href: "#mcp", label: t.nav.mcp },
];
---

<header class="site-header">
	<div class="header-inner">
		<a href="#top" class="brand" aria-label="Speekify — home"><BrandMark class="brand-mark" /><strong>Speekify</strong></a>
		<nav class="desktop-nav" aria-label="Primary navigation">{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
		<div class="header-actions">
			<nav class="language-nav" aria-label="Language">
				{alternates.map((alt) => <a href={alt.rel} hreflang={alt.locale} aria-current={alt.locale === lang ? "page" : undefined} class:list={[alt.locale === lang && "active"]}>{alt.locale.toUpperCase()}<span class="sr-only"> — {languages[alt.locale]}</span></a>)}
			</nav>
			<a class="github-link" href={repo}>GitHub <span aria-hidden="true">↗</span></a>
			<a class="install-link" href="#install">{lang === "fr" ? "Installer" : "Install"}</a>
			<details class="mobile-menu">
				<summary aria-label={t.nav.menu}><span></span><span></span></summary>
				<div>{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}<a href={repo}>GitHub ↗</a>{alternates.map((alt) => <a href={alt.rel} hreflang={alt.locale}>{languages[alt.locale]}</a>)}</div>
			</details>
		</div>
	</div>
</header>

<style>
	.site-header{position:sticky;top:0;z-index:50;height:68px;border-bottom:1px solid rgba(213,217,226,.85);background:rgba(247,248,251,.82);backdrop-filter:blur(18px)}.header-inner{width:min(1180px,calc(100% - 40px));height:100%;margin-inline:auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:30px}.brand{display:flex;align-items:center;gap:10px;width:max-content;font-family:var(--font-sans);color:var(--brand-blue)}.brand-mark{width:32px;height:32px;filter:drop-shadow(0 6px 12px rgba(49,92,255,.22));transition:transform .35s cubic-bezier(.22,1,.36,1)}.brand:hover .brand-mark{transform:rotate(-5deg) scale(1.06)}.brand strong{font-size:17px;letter-spacing:-.03em;color:#15171c}.desktop-nav{display:flex;align-items:center;gap:27px}.desktop-nav a,.github-link,.language-nav a{font:500 12px/1 var(--font-sans);color:#656b78;transition:color .2s}.desktop-nav a:hover,.github-link:hover,.language-nav a:hover,.language-nav a.active{color:#15171c}.header-actions{display:flex;align-items:center;justify-content:flex-end;gap:18px}.language-nav{display:flex;gap:8px}.language-nav a+a:before{content:"/";margin-right:8px;color:#b0b4bd}.install-link{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border-radius:999px;background:#15171c;color:white;font:600 12px/1 var(--font-sans);transition:background .2s,transform .25s cubic-bezier(.22,1,.36,1)}.install-link:hover{background:var(--brand-blue);transform:translateY(-1px)}.mobile-menu{display:none;position:relative}.mobile-menu summary{width:34px;height:34px;display:flex;flex-direction:column;justify-content:center;gap:5px;cursor:pointer;list-style:none}.mobile-menu summary span{display:block;width:20px;height:1.5px;background:#17191f}.mobile-menu>div{position:absolute;right:0;top:42px;width:200px;padding:10px;display:flex;flex-direction:column;border:1px solid #d9dce4;border-radius:12px;background:#fff;box-shadow:0 18px 50px #1c21301f}.mobile-menu>div a{padding:10px;border-radius:8px;font:500 13px/1 var(--font-sans);color:#555b68}.mobile-menu>div a:hover{background:#f0f2f7;color:#15171c}@media(max-width:820px){.header-inner{grid-template-columns:1fr auto}.desktop-nav,.github-link,.language-nav{display:none}.mobile-menu{display:block}}@media(max-width:520px){.header-inner{width:calc(100% - 28px)}.brand strong{display:none}}@media(prefers-reduced-motion:reduce){.brand-mark,.install-link{transition:none}.brand:hover .brand-mark{transform:none}}
</style>

<style is:global>
	.brand-mark{display:block;width:32px;height:32px;filter:drop-shadow(0 6px 12px rgba(49,92,255,.22));transition:transform .35s cubic-bezier(.22,1,.36,1)}
	.brand:hover .brand-mark{transform:rotate(-5deg) scale(1.06)}
	@media(prefers-reduced-motion:reduce){.brand-mark{transition:none}.brand:hover .brand-mark{transform:none}}
</style>
