---
import Header from "@/components/landing/Header.astro";
import CodeBlock from "@/components/landing/CodeBlock";
import BrandMark from "@/components/landing/BrandMark.astro";
import { getContent, type Lang } from "@/i18n/content";
import IconArrowRight from "@tabler/icons-react/dist/esm/icons/IconArrowRight.mjs";
import IconBrandYoutube from "@tabler/icons-react/dist/esm/icons/IconBrandYoutube.mjs";
import IconCommand from "@tabler/icons-react/dist/esm/icons/IconCommand.mjs";
import IconDownload from "@tabler/icons-react/dist/esm/icons/IconDownload.mjs";
import IconFileMusic from "@tabler/icons-react/dist/esm/icons/IconFileMusic.mjs";
import IconFileText from "@tabler/icons-react/dist/esm/icons/IconFileText.mjs";
import IconLock from "@tabler/icons-react/dist/esm/icons/IconLock.mjs";
import IconPlayerPlay from "@tabler/icons-react/dist/esm/icons/IconPlayerPlay.mjs";
import IconRobot from "@tabler/icons-react/dist/esm/icons/IconRobot.mjs";
import IconTerminal2 from "@tabler/icons-react/dist/esm/icons/IconTerminal2.mjs";
import IconWaveSine from "@tabler/icons-react/dist/esm/icons/IconWaveSine.mjs";
import IconWorldWww from "@tabler/icons-react/dist/esm/icons/IconWorldWww.mjs";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = getContent(lang);
const isFr = lang === "fr";
const repo = "https://github.com/OtterlySpaceLabs/speekify";

const wave = [18, 28, 46, 72, 42, 24, 54, 88, 62, 34, 22, 44, 76, 96, 58, 30, 48, 82, 66, 38, 20, 36, 68, 90, 52, 26, 40, 74, 56, 32, 18, 28, 52, 80, 46, 24, 38, 64, 48, 22];

const sourceCards = [
	{ icon: IconFileText, title: isFr ? "Texte" : "Text", code: 'speekify "Hello world"' },
	{ icon: IconWorldWww, title: "URL", code: "speekify example.com/article" },
	{ icon: IconFileMusic, title: isFr ? "Fichiers" : "Files", code: "speekify report.pdf" },
	{ icon: IconBrandYoutube, title: "YouTube", code: "speekify youtube.com/watch?v=…" },
	{ icon: IconTerminal2, title: "stdin", code: "cat notes.md | speekify" },
];

const steps = isFr
	? [
		{ eyebrow: "Choisissez", title: "Donnez-lui ce qui mérite votre attention.", body: "Un article gardé pour plus tard, un rapport dense, une vidéo trop longue : Speekify reconnaît la source sans vous ralentir." },
		{ eyebrow: "Transformez", title: "Laissez votre machine lui donner une voix.", body: "Supertonic v3 crée une écoute naturelle, dans la langue, la voix et le rythme qui vous conviennent — sans envoyer vos contenus ailleurs." },
		{ eyebrow: "Emportez", title: "Retrouvez du temps sans perdre le fil.", body: "Votre WAV vous attend. Marchez, voyagez ou fermez simplement l’écran : ce qui compte continue avec vous." },
	]
	: [
		{ eyebrow: "Choose", title: "Give it what deserves your attention.", body: "A saved article, a dense report, a video you never found time for: Speekify recognises the source without slowing you down." },
		{ eyebrow: "Transform", title: "Let your machine give it a voice.", body: "Supertonic v3 creates a natural listen in the language, voice, and pace that suit you — without sending your content elsewhere." },
		{ eyebrow: "Take it", title: "Find time without losing the thread.", body: "Your WAV is waiting. Walk, travel, or simply close the screen: what matters keeps moving with you." },
	];

const examples = [
	{ label: t.cli.labels[0], code: 'speekify "Hello world"' },
	{ label: t.cli.labels[1], code: 'speekify "https://example.com/article"' },
	{ label: t.cli.labels[2], code: "speekify ~/Documents/article.pdf" },
	{ label: t.cli.labels[3], code: 'speekify --lang fr "https://youtube.com/watch?v=…"' },
];

const installCommands = [
	{ icon: IconDownload, label: "Homebrew", code: "brew tap otterlyspacelabs/speekify https://github.com/OtterlySpaceLabs/speekify\nbrew install speekify\nspeekify setup" },
	{ icon: IconTerminal2, label: "pipx / uv", code: "pipx install speekify   # or: uv tool install speekify\nspeekify setup" },
	{ icon: IconCommand, label: isFr ? "Depuis les sources" : "From source", code: "uv sync\nuv run speekify setup" },
];

const stepIcons = [IconFileText, IconWaveSine, IconFileMusic];
---

<Header />

<main>
	<section id="top" class="hero section-shell">
		<div class="hero-copy">
			<div class="eyebrow"><span class="status-dot"></span>{t.hero.badgeText}</div>
			<h1>{t.hero.title} <em>{t.hero.titleAccent}</em></h1>
			<p>{t.hero.description}</p>
			<div class="hero-actions">
				<a class="button button-primary" href="#install">{t.hero.getStarted}</a>
				<a class="button button-secondary" href={repo}>{t.hero.viewGithub} <span aria-hidden="true">↗</span></a>
			</div>
			<div class="hero-meta"><span>{isFr ? "0 cloud" : "0 cloud"}</span><span>{isFr ? "Votre fichier WAV" : "Your own WAV"}</span><span>Open source · MIT</span></div>
		</div>

		<div class="terminal-stage" aria-label={isFr ? "Exemple d’exécution de Speekify" : "Example Speekify run"}>
			<div class="source-deck" aria-hidden="true">
				<div class="source-ticket source-ticket--web"><IconWorldWww size={16} stroke={1.7} /><span><b>ARTICLE</b><small>WEB</small></span></div>
				<div class="source-ticket source-ticket--pdf"><IconFileText size={16} stroke={1.7} /><span><b>RAPPORT</b><small>PDF</small></span></div>
				<div class="source-ticket source-ticket--video"><IconBrandYoutube size={16} stroke={1.7} /><span><b>YOUTUBE</b><small>VIDEO</small></span></div>
			</div>
			<div class="local-stamp"><IconLock size={15} stroke={1.8} /><span><b>LOCAL</b><small>0 upload</small></span></div>
			<div class="terminal-window">
				<div class="terminal-bar"><div><i></i><i></i><i></i></div><span>speekify — zsh</span><b>⌘</b></div>
				<div class="terminal-body">
					<p><span class="prompt">$</span> speekify https://example.com/article</p>
					<p class="terminal-muted">{isFr ? "Analyse de la source…" : "Reading source…"}</p>
					<p><span class="check">✓</span> {isFr ? "Contenu extrait" : "Content extracted"} <span class="dim">· 2 418 words</span></p>
					<p><span class="check">✓</span> {isFr ? "Langue détectée" : "Language detected"} <span class="dim">· français</span></p>
					<p><span class="check">✓</span> {isFr ? "Voix" : "Voice"} <span class="dim">· F2 · 1.0×</span></p>
					<p class="terminal-success"><span class="check">→</span> article.wav <span class="dim">· {isFr ? "généré localement" : "generated locally"}</span></p>
				</div>
			</div>
			<div class="audio-ticket">
				<span class="audio-ticket__play"><IconPlayerPlay size={16} fill="currentColor" /></span>
				<div class="audio-ticket__copy"><small>{isFr ? "VOTRE AUDIO" : "YOUR AUDIO"}</small><strong>article.wav</strong></div>
				<div class="audio-ticket__wave" aria-hidden="true">{wave.slice(9, 25).map((height) => <i style={`height:${Math.max(16, height * .62)}%`}></i>)}</div>
				<span class="audio-ticket__time">18:42</span>
			</div>
		</div>
	</section>

	<section class="source-section section-shell" id="sources">
		<div class="section-heading split-heading">
			<div><span class="kicker">01 / {isFr ? "Vos sources" : "Your sources"}</span><h2>{t.what.title}</h2></div>
			<p>{t.what.subtitle}</p>
		</div>
		<div class="source-grid">
			{sourceCards.map(({ icon: SourceIcon, ...source }) => (
				<article class="source-card">
					<span class="source-mark"><SourceIcon size={21} stroke={1.7} /></span>
					<div><h3>{source.title}</h3><code>{source.code}</code></div>
				</article>
			))}
		</div>
	</section>

	<section id="how" class="steps-section">
		<div class="section-shell">
			<div class="section-heading"><span class="kicker light">02 / {isFr ? "Le déclic" : "The shift"}</span><h2>{isFr ? "Trois gestes. Puis votre écran peut s’éteindre." : "Three moves. Then your screen can go dark."}</h2></div>
			<div class="steps-grid">
				{steps.map((step, index) => {
					const StepIcon = stepIcons[index];
					return <article class="step-card">
						<span class="step-number">0{index + 1}</span><span class="step-eyebrow">{step.eyebrow}</span>
						<h3>{step.title}</h3><p>{step.body}</p>
						<div class={`step-visual visual-${index + 1}`} aria-hidden="true"><div class="step-icon"><StepIcon size={36} stroke={1.45} /></div><span></span><span></span><span></span></div>
					</article>;
				})}
			</div>
		</div>
	</section>

	<section id="privacy" class="privacy-section section-shell">
		<div class="privacy-copy">
			<span class="kicker">03 / {isFr ? "Local par conception" : "Local by design"}</span>
			<h2>{isFr ? "Vos idées restent là où elles vous appartiennent." : "Your ideas stay where they belong."}</h2>
			<p>{isFr ? "Votre lecture entre, votre audio ressort — sur la même machine. Aucun compte à créer, aucun service vocal à alimenter, aucun format propriétaire à subir." : "Your reading goes in and your audio comes out — on the same machine. No account to create, no remote voice service to feed, no proprietary format to live with."}</p>
		</div>
		<div class="privacy-proof">
			<div class="privacy-orbit"><span>LOCAL</span><i></i><div class="privacy-lock"><IconLock size={34} stroke={1.45} /></div><b>WAV</b></div>
			<ul>
				<li><span>01</span><div><strong>Supertonic v3</strong><small>{isFr ? "Synthèse sur votre appareil" : "On-device synthesis"}</small></div></li>
				<li><span>02</span><div><strong>{isFr ? "Aucun compte" : "No account"}</strong><small>{isFr ? "Une commande suffit" : "Just run a command"}</small></div></li>
				<li><span>03</span><div><strong>{isFr ? "Un fichier standard" : "A standard file"}</strong><small>{isFr ? "Écoutez-le partout" : "Play it anywhere"}</small></div></li>
			</ul>
		</div>
	</section>

	<section id="cli" class="cli-section section-shell">
		<div class="section-heading split-heading">
			<div><span class="kicker">04 / CLI</span><h2>{t.cli.title}</h2></div><p>{t.cli.subtitle}</p>
		</div>
		<div class="cli-layout">
			<div class="cli-feature">
				<div class="feature-label"><span>●</span> live command</div>
				<div class="terminal-shell"><CodeBlock client:load code={'speekify --voice F2 --output-dir ~/Desktop "Hello world"'} /></div>
				<div class="equalizer" aria-hidden="true">{wave.slice(0, 24).map((height) => <i style={`height:${Math.max(12, height * .62)}%`}></i>)}</div>
				<div class="cli-result"><span>hello-world.wav</span><span>00:03</span></div>
			</div>
			<div class="example-list">
				{examples.map((example, index) => (
					<div class="example-row"><span>0{index + 1}</span><div><p>{example.label}</p><code>{example.code}</code></div></div>
				))}
				<a class="text-link" href={`${repo}/blob/main/docs/usage.md`}>{t.cli.fullRef}</a>
			</div>
		</div>
	</section>

	<section class="voices-section section-shell">
		<div class="voices-card">
			<div><span class="kicker light">05 / {isFr ? "À votre oreille" : "Make it yours"}</span><h2>{isFr ? "Un audio que vous aurez envie d’écouter." : "Audio you will actually want to hear."}</h2><p>{t.what.cards[3].body}</p></div>
			<div class="voice-console">
				<div class="voice-pills">{["F1", "F2", "F3", "F4", "F5", "M1", "M2", "M3", "M4", "M5"].map((voice) => <span class:list={[voice === "F2" && "active"]}>{voice}</span>)}</div>
				<div class="voice-slider"><span>{isFr ? "Vitesse" : "Speed"}</span><div><i></i></div><b>1.0×</b></div>
				<div class="voice-wave" aria-hidden="true">{wave.slice(4, 32).map((height) => <i style={`height:${height}%`}></i>)}</div>
			</div>
		</div>
	</section>

	<section id="mcp" class="mcp-section section-shell">
		<div class="mcp-grid">
			<div class="mcp-copy"><span class="kicker">06 / MCP</span><h2>{t.mcp.title}</h2><p>{t.mcp.subtitle}</p><a class="text-link" href={`${repo}/blob/main/docs/mcp-clients.md`}>{t.mcp.perClient}</a></div>
			<div class="mcp-flow" aria-label={isFr ? "Flux d’automatisation MCP" : "MCP automation flow"}>
				<div><span><IconRobot size={25} stroke={1.55} /></span><strong>{isFr ? "Assistant" : "Assistant"}</strong></div><i><IconArrowRight size={17} /></i><div class="accent"><span><BrandMark class="flow-mark" /></span><strong>Speekify MCP</strong></div><i><IconArrowRight size={17} /></i><div><span><IconFileMusic size={25} stroke={1.55} /></span><strong>recap.wav</strong></div>
				<code>speekify_generate_wav()</code>
			</div>
		</div>
	</section>

	<section id="install" class="install-section">
		<div class="install-shell section-shell">
			<div class="install-intro"><span class="kicker light">07 / {isFr ? "À vous de jouer" : "Your turn"}</span><h2>{t.install.title}</h2><p>{t.install.note}</p></div>
			<div class="install-journey" aria-hidden="true"><span class="active"><IconDownload size={17} /></span><i></i><span><IconTerminal2 size={17} /></span><i></i><span><IconWaveSine size={17} /></span></div>
			<div class="install-grid">{installCommands.map(({ icon: InstallIcon, ...item }, index) => <div class="install-command"><div class="install-label"><span>0{index + 1}</span><InstallIcon size={17} stroke={1.7} /><strong>{item.label}</strong></div><CodeBlock client:load code={item.code} /></div>)}</div>
		</div>
	</section>

	<section id="faq" class="faq-section section-shell">
		<div class="faq-heading split-heading">
			<div><span class="kicker">08 / {isFr ? "Questions fréquentes" : "Frequently asked"}</span><h2>{t.faq.title}</h2></div>
			<p>{t.faq.subtitle}</p>
		</div>
		<div class="faq-list">
			{t.faq.items.map((item, index) => (
				<details class="faq-item">
					<summary><span>0{index + 1}</span><strong>{item.question}</strong><i aria-hidden="true"></i></summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</section>

	<section class="final-cta section-shell">
		<span class="kicker">{isFr ? "Construit en public · Licence MIT" : "Built in public · MIT licensed"}</span>
		<h2>{t.openSource.title}</h2>
		<p>{t.openSource.body}</p>
		<div class="hero-actions"><a class="button button-primary" href="#install">{t.hero.getStarted}</a><a class="button button-secondary" href={repo}>{t.openSource.star} <span aria-hidden="true">↗</span></a></div>
	</section>
</main>

<footer class="site-footer">
	<div class="section-shell footer-grid">
		<div><a href="#top" class="footer-logo"><BrandMark class="footer-mark" />Speekify</a><p>{t.footer.tagline}</p></div>
		<nav>{t.footer.links.map((label, index) => <a href={[repo, `${repo}#readme`, `${repo}/blob/main/docs/usage.md`, `${repo}/blob/main/docs/mcp-clients.md`][index]}>{label}</a>)}</nav>
		<div class="footer-legal"><span>{t.footer.license}</span><p>{t.footer.disclaimer}</p></div>
	</div>
</footer>

<script>
	const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
	const targets = document.querySelectorAll(
		".section-heading, .source-card, .step-card, .privacy-copy, .privacy-proof, .cli-feature, .example-list, .voices-card, .mcp-copy, .mcp-flow, .install-intro, .install-journey, .install-command, .faq-heading, .faq-item, .final-cta",
	);

	if (motionQuery.matches || !("IntersectionObserver" in window)) {
		targets.forEach((target) => target.classList.add("is-visible"));
	} else {
		targets.forEach((target) => target.classList.add("reveal-item"));
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				});
			},
			{ rootMargin: "0px 0px -10%", threshold: 0.08 },
		);
		targets.forEach((target) => observer.observe(target));
	}
</script>

<style>
	.section-shell{width:min(1180px,calc(100% - 40px));margin-inline:auto}.hero{min-height:740px;padding:92px 0 0;position:relative;display:grid;grid-template-columns:1.04fr .96fr;gap:64px;align-items:start;overflow:hidden}.hero-copy{position:relative;z-index:2;padding-top:28px}.hero-copy>*{opacity:0;animation:hero-in .72s cubic-bezier(.22,1,.36,1) forwards}.hero-copy>*:nth-child(2){animation-delay:.08s}.hero-copy>*:nth-child(3){animation-delay:.16s}.hero-copy>*:nth-child(4){animation-delay:.24s}.hero-copy>*:nth-child(5){animation-delay:.32s}.eyebrow,.kicker{font:600 11px/1 var(--font-mono);letter-spacing:.12em;text-transform:uppercase;color:#5e6471}.eyebrow{display:inline-flex;align-items:center;gap:9px;padding:8px 12px;border:1px solid #d9dce4;border-radius:999px;background:rgba(255,255,255,.72);letter-spacing:0;text-transform:none}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--brand-blue);box-shadow:0 0 0 4px rgba(49,92,255,.12)}h1{font-size:clamp(3.2rem,5.7vw,6.1rem);line-height:.91;letter-spacing:-.07em;margin:26px 0 0;max-width:780px}h1 em{display:block;font-family:var(--font-body);font-weight:400;color:var(--brand-blue);letter-spacing:-.055em}.hero-copy>p{font:400 17px/1.55 var(--font-sans);max-width:650px;margin:26px 0 0;color:#5d6370}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;height:46px;padding:0 21px;border-radius:999px;font:600 14px/1 var(--font-sans);transition:transform .25s cubic-bezier(.22,1,.36,1),background .25s,color .25s}.button:hover{transform:translateY(-2px)}.button-primary{background:#15171c;color:#fff}.button-primary:hover{background:var(--brand-blue)}.button-secondary{border:1px solid #cfd3dc;background:rgba(255,255,255,.65);color:#15171c}.hero-meta{display:flex;gap:20px;flex-wrap:wrap;margin-top:26px;font:500 10px/1 var(--font-mono);text-transform:uppercase;color:#747a87}.hero-meta span+span:before{content:"·";margin-rig