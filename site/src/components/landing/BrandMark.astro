---
interface Props {
	class?: string;
	label?: string;
}

const { class: className, label } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 40 40"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
>
	<rect x="1" y="1" width="38" height="38" rx="11" fill="currentColor" />
	<path
		d="M8.5 21.2c2.45 0 2.45-7.4 4.9-7.4s2.45 12.4 4.9 12.4 2.45-17.2 4.9-17.2 2.45 21.8 4.9 21.8 2.45-9.6 4.9-9.6"
		stroke="white"
		stroke-width="2.6"
		stroke-linecap="round"
		stroke-linejoin="round"
	/>
	<circle cx="8.5" cy="21.2" r="1.7" fill="#AFC0FF" />
	<circle cx="33" cy="21.2" r="1.7" fill="#AFC0FF" />
</svg>
