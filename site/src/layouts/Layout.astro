---
import "@/styles/global.css";
import { getContent, type Lang } from "@/i18n/content";
import { getAlternates } from "@/i18n/utils";

interface Props {
	title?: string;
	description?: string;
}

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = getContent(lang);
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternates = getAlternates(Astro.url.pathname, lang);
const xDefault = alternates.find((a) => a.locale === "en")!.abs;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const ogLocale = lang === "fr" ? "fr_FR" : "en_US";
const altLocale = lang === "fr" ? "en_US" : "fr_FR";
const siteUrl = new URL(`${base}/`, Astro.site).href;
const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const softwareId = `${siteUrl}#software`;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": organizationId,
			name: "Otterly Space Labs",
			url: "https://github.com/OtterlySpaceLabs",
			sameAs: ["https://github.com/OtterlySpaceLabs"],
		},
		{
			"@type": "WebSite",
			"@id": websiteId,
			name: "Speekify",
			url: siteUrl,
			inLanguage: ["en", "fr"],
			publisher: { "@id": organizationId },
		},
		{
			"@type": "SoftwareApplication",
			"@id": softwareId,
			name: "Speekify",
			applicationCategory: "MultimediaApplication",
			applicationSubCategory: "Local text-to-speech command-line interface",
			operatingSystem: "macOS, Linux, Windows",
			description,
			url: canonical,
			image: ogImage,
			inLanguage: lang,
			isAccessibleForFree: true,
			downloadUrl: "https://github.com/OtterlySpaceLabs/speekify/releases",
			softwareRequirements: "Python 3.11 or later, or the standalone macOS package",
			featureList: [
				"Local text-to-speech synthesis with Supertonic v3",
				"Articles, text-based PDFs, YouTube transcripts, local files, and stdin",
				"WAV audio output",
				"Multilingual synthesis with ten built-in voices",
				"MCP server for AI assistants",
			],
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
			license: "https://opensource.org/licenses/MIT",
			publisher: { "@id": organizationId },
			mainEntityOfPage: { "@id": canonical },
		},
		{
			"@type": "FAQPage",
			"@id": `${canonical}#faq`,
			url: `${canonical}#faq`,
			inLanguage: lang,
			isPartOf: { "@id": websiteId },
			mainEntity: t.faq.items.map((item) => ({
				"@type": "Question",
				name: item.question,
				acceptedAnswer: { "@type": "Answer", text: item.answer },
			})),
		},
	],
};
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Otterly Space Labs" />
		<meta name="application-name" content="Speekify" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#f7f8fb" />
		<link rel="canonical" href={canonical} />
		<link rel="manifest" href={`${base}/site.webmanifest`} />

		{alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.abs} />)}
		<link rel="alternate" hreflang="x-default" href={xDefault} />
		<link rel="sitemap" type="application/xml" title="Sitemap" href={`${base}/sitemap-index.xml`} />

		<meta property="og:site_name" content="Speekify" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Speekify" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={altLocale} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Speekify" />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />
	</body>
</html>
